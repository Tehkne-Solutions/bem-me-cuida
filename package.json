{
  "name": "bem-me-cuida",
  "version": "0.10.0",
  "private": true,
  "description": "Aplicativo mobile-first para acompanhamento emocional, autocuidado e organização do tratamento.",
  "license": "UNLICENSED",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "npm run start --workspace @bemmecuida/mobile",
    "mobile:android": "npm run android --workspace @bemmecuida/mobile",
    "mobile:ios": "npm run ios --workspace @bemmecuida/mobile",
    "mobile:web": "npm run web --workspace @bemmecuida/mobile",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "check": "npm run typecheck && npm run lint && npm run test",
    "config:check": "node --env-file-if-exists=.env scripts/verify-environment.mjs",
    "staging:check": "node --env-file-if-exists=.env scripts/verify-staging-readiness.mjs",
    "beta:check": "node --env-file-if-exists=.env scripts/verify-beta-readiness.mjs",
    "rc:check": "node --env-file-if-exists=.env scripts/verify-rc-readiness.mjs",
    "production:check": "node --env-file-if-exists=.env scripts/verify-production-readiness.mjs",
    "ota:check": "node --env-file-if-exists=.env scripts/verify-ota-readiness.mjs",
    "cycle:rc:check": "node --env-file-if-exists=.env scripts/verify-cycle-rc-readiness.mjs",
    "rc011:prebuild:check": "node --env-file-if-exists=.env scripts/verify-rc011-readiness.mjs prebuild",
    "rc011:artifacts:check": "node --env-file-if-exists=.env scripts/verify-rc011-readiness.mjs artifacts",
    "rc011:promotion:check": "node --env-file-if-exists=.env scripts/verify-rc011-readiness.mjs promotion",
    "rc011:homologation:structure": "node --env-file-if-exists=.env scripts/verify-rc011-homologation.mjs structure",
    "rc011:homologation:capture": "node --env-file-if-exists=.env scripts/verify-rc011-homologation.mjs capture",
    "rc011:homologation:promotion": "node --env-file-if-exists=.env scripts/verify-rc011-homologation.mjs promotion",
    "rc011:decision:package": "node --env-file-if-exists=.env scripts/generate-rc011-decision-package.mjs",
    "rc011:evidence:record": "node scripts/record-rc011-evidence.mjs",
    "rc011:capture:apply": "node scripts/apply-rc011-capture.mjs",
    "rc011:infrastructure:structure": "node --env-file-if-exists=.env scripts/verify-rc011-infrastructure.mjs structure",
    "rc011:infrastructure:external": "node --env-file-if-exists=.env scripts/verify-rc011-infrastructure.mjs external",
    "rc011:infrastructure:report": "node --env-file-if-exists=.env scripts/generate-rc011-infrastructure-report.mjs",
    "rc011:infrastructure:capture:apply": "node scripts/apply-rc011-infrastructure-capture.mjs",
    "rc011:bootstrap:bundle": "node --env-file-if-exists=.env scripts/generate-rc011-bootstrap-bundle.mjs",
    "rc011:bootstrap:structure": "node --env-file-if-exists=.env scripts/verify-rc011-bootstrap.mjs structure",
    "rc011:bootstrap:check": "npm run rc011:bootstrap:structure && npm run rc011:bootstrap:bundle && node --env-file-if-exists=.env scripts/verify-rc011-bootstrap.mjs bundle",
    "rc011:command:test": "node scripts/test-rc011-issue-command.mjs",
    "rc011:command:status": "node scripts/generate-rc011-issue-status.mjs",
    "sprint10:check": "node scripts/verify-sprint10-readiness.mjs",
    "sprint11:check": "node scripts/verify-sprint11-readiness.mjs",
    "sprint12:check": "node scripts/verify-sprint12-readiness.mjs",
    "sprint13:check": "node scripts/verify-sprint13-readiness.mjs",
    "sprint14:check": "node scripts/verify-sprint14-readiness.mjs",
    "sprint15:check": "node scripts/verify-sprint15-readiness.mjs",
    "sprint16:check": "node scripts/verify-sprint16-readiness.mjs",
    "sprint17:check": "node scripts/verify-sprint17-readiness.mjs",
    "sprint18:check": "node scripts/verify-sprint18-readiness.mjs",
    "sprint19:check": "node scripts/verify-sprint19-readiness.mjs",
    "release:manifest": "node --env-file-if-exists=.env scripts/generate-release-manifest.mjs",
    "rc011:manifest": "node --env-file-if-exists=.env scripts/generate-rc011-manifest.mjs",
    "rc011:validation:report": "node --env-file-if-exists=.env scripts/generate-rc011-validation-report.mjs",
    "rc011:gates:payload": "node --env-file-if-exists=.env scripts/generate-rc011-gate-payload.mjs",
    "store:package": "node --env-file-if-exists=.env scripts/generate-store-submission-package.mjs",
    "hotfix:manifest": "node --env-file-if-exists=.env scripts/generate-hotfix-manifest.mjs",
    "governance:report": "node --env-file-if-exists=.env scripts/generate-governance-report.mjs",
    "cycle:report": "node --env-file-if-exists=.env scripts/generate-cycle-execution-report.mjs",
    "ota:publish:validation": "node --env-file-if-exists=.env scripts/verify-ota-readiness.mjs publish-validation && node --env-file-if-exists=.env scripts/execute-ota-operation.mjs publish-validation",
    "ota:promote:production": "node --env-file-if-exists=.env scripts/verify-ota-readiness.mjs promote-production && node --env-file-if-exists=.env scripts/execute-ota-operation.mjs promote-production",
    "ota:rollback:production": "node --env-file-if-exists=.env scripts/verify-ota-readiness.mjs rollback-production && node --env-file-if-exists=.env scripts/execute-ota-operation.mjs rollback-production",
    "ota:cancel-rollout": "node --env-file-if-exists=.env scripts/verify-ota-readiness.mjs cancel-rollout && node --env-file-if-exists=.env scripts/execute-ota-operation.mjs cancel-rollout",
    "supabase:start": "npx supabase@latest start",
    "supabase:stop": "npx supabase@latest stop",
    "supabase:test": "npx supabase@latest test db",
    "supabase:lint": "npx supabase@latest db lint --local",
    "supabase:push:staging": "node --env-file-if-exists=.env scripts/push-supabase-staging.mjs",
    "build:android:development": "npm run build:android:development --workspace @bemmecuida/mobile",
    "build:android:preview": "npm run build:android:preview --workspace @bemmecuida/mobile",
    "build:android:beta": "npm run build:android:beta --workspace @bemmecuida/mobile",
    "build:android:rc": "npm run build:android:rc --workspace @bemmecuida/mobile",
    "build:android:rc011": "npm run build:android:rc011 --workspace @bemmecuida/mobile",
    "build:ios:rc011": "npm run build:ios:rc011 --workspace @bemmecuida/mobile",
    "build:android:hotfix-validation": "npm run build:android:hotfix-validation --workspace @bemmecuida/mobile",
    "build:android:production": "npm run build:android:production --workspace @bemmecuida/mobile",
    "build:ios:production": "npm run build:ios:production --workspace @bemmecuida/mobile",
    "submit:android:production": "npm run submit:android:production --workspace @bemmecuida/mobile",
    "submit:ios:production": "npm run submit:ios:production --workspace @bemmecuida/mobile",
    "e2e:smoke": "maestro test .maestro/smoke-public.yml",
    "e2e:check-in": "maestro test .maestro/authenticated-check-in.yml",
    "release:check": "node scripts/verify-release-readiness.mjs && node scripts/verify-sprint09-readiness.mjs && node scripts/verify-sprint10-readiness.mjs && node scripts/verify-sprint11-readiness.mjs && node scripts/verify-sprint12-readiness.mjs && node scripts/verify-sprint13-readiness.mjs && node scripts/verify-sprint14-readiness.mjs && node scripts/verify-sprint15-readiness.mjs && node scripts/verify-sprint16-readiness.mjs && node scripts/verify-sprint17-readiness.mjs && node scripts/verify-sprint18-readiness.mjs && node scripts/verify-sprint19-readiness.mjs",
    "verify": "npm run config:check && npm run security:check && npm run check",
    "security:check": "node scripts/check-sensitive-files.mjs",
    "e2e:care": "maestro test .maestro/authenticated-care.yml",
    "e2e:management": "maestro test .maestro/care-management.yml",
    "e2e:journal": "maestro test .maestro/journal-insights.yml",
    "e2e:support": "maestro test .maestro/support-plan.yml",
    "e2e:reports": "maestro test .maestro/reports.yml",
    "e2e:settings": "maestro test .maestro/settings-privacy.yml",
    "e2e:preferences": "maestro test .maestro/preferences-accessibility.yml",
    "e2e:beta": "maestro test .maestro/beta-center.yml",
    "e2e:operator": "maestro test .maestro/operator-console.yml",
    "e2e:production": "maestro test .maestro/production-console.yml",
    "e2e:maintenance": "maestro test .maestro/maintenance-console.yml",
    "e2e:governance": "maestro test .maestro/governance-console.yml",
    "e2e:cycle": "maestro test .maestro/cycle-execution-console.yml",
    "e2e:rc011": "maestro test .maestro/rc011-smoke.yml",
    "e2e:upgrade:rc011": "maestro test .maestro/upgrade-010-to-011.yml"
  }
}
