# Ambiente local do aplicativo. Nunca inclua service_role ou segredos administrativos.
APP_VARIANT=development
EXPO_PUBLIC_APP_ENV=development
# Opcional. Na RC 2 use 2 para exibir 0.10.0-rc.2.
EXPO_PUBLIC_RELEASE_CANDIDATE=
# Na primeira produção controlada use 1.
EXPO_PUBLIC_PRODUCTION_RELEASE=
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUBSTITUA
# Preenchido depois de executar `eas init`.
EXPO_PUBLIC_EAS_PROJECT_ID=

# URLs públicas exigidas pelo production:check e pelo pacote de submissão.
PRODUCTION_SUPPORT_URL=https://SEU-DOMINIO/suporte
PRODUCTION_PRIVACY_URL=https://SEU-DOMINIO/privacidade
PRODUCTION_TERMS_URL=https://SEU-DOMINIO/termos

# Metadados de artefatos. Nunca inclua credenciais de assinatura.
ANDROID_BUILD_NUMBER=
ANDROID_ARTIFACT_URL=
ANDROID_ARTIFACT_SHA256=
IOS_BUILD_NUMBER=
IOS_ARTIFACT_URL=
IOS_ARTIFACT_SHA256=
STORE_PACKAGE_OUTPUT=artifacts/bemmecuida-0.10.0-production-1.json

# Operação de hotfix e OTA. EXPO_TOKEN fica somente no ambiente protegido.
OTA_ACTION=validate
OTA_HOTFIX_ID=
OTA_APPROVAL_ID=
HOTFIX_VERSION=0.10.1
HOTFIX_KIND=ota
HOTFIX_SEVERITY=high
OTA_RUNTIME_VERSION=0.10.0
OTA_CHANNEL=hotfix-validation
OTA_MESSAGE=
OTA_FINGERPRINT_SHA256=
OTA_SOURCE_COMMIT=
OTA_ASSET_COUNT=0
OTA_ROLLOUT_PERCENTAGE=5
OTA_NATIVE_CHANGES=false
OTA_VALIDATED_GROUP_ID=
OTA_PUBLISHED_GROUP_ID=
OTA_CURRENT_GROUP_ID=
OTA_ROLLBACK_GROUP_ID=
HOTFIX_MANIFEST_OUTPUT=artifacts/bemmecuida-hotfix.json

# Relatório executivo agregado. Não inclua dados pessoais ou clínicos.
GOVERNANCE_REPORT_OUTPUT=artifacts/bemmecuida-governance-report.json
GOVERNANCE_REPORT_MARKDOWN_OUTPUT=artifacts/bemmecuida-governance-report.md
GOVERNANCE_CYCLE_VERSION=0.11.0
GOVERNANCE_CYCLE_STATUS=planning
GOVERNANCE_CYCLE_READINESS=blocked
GOVERNANCE_ACTIVE_SLOS=0
GOVERNANCE_CRITICAL_SLOS=0
GOVERNANCE_CRITICAL_INCIDENTS_OPEN=0
GOVERNANCE_CORRECTIVE_ACTIONS_OPEN=0
GOVERNANCE_POSTMORTEMS_PENDING=0
GOVERNANCE_ACTIVE_ACCOUNTS=0
GOVERNANCE_SYNC_OPERATIONS=0
GOVERNANCE_STORAGE_MEGABYTES=0
GOVERNANCE_NOTIFICATION_DELIVERIES=0
GOVERNANCE_ESTIMATED_COST_BRL=0
GOVERNANCE_BUDGET_BRL=0
GOVERNANCE_MAINTENANCE_WINDOWS_PENDING=0
GOVERNANCE_SECURITY_DEPENDENCIES_OPEN=0
GOVERNANCE_DEPENDENCIES_IN_PROGRESS=0

# Execução agregada do ciclo 0.11.0 e preparação da RC.
CYCLE_EXECUTION_REPORT_OUTPUT=artifacts/bemmecuida-cycle-0.11.0.json
CYCLE_EXECUTION_REPORT_MARKDOWN_OUTPUT=artifacts/bemmecuida-cycle-0.11.0.md
CYCLE_VERSION=0.11.0
CYCLE_RC_VERSION=0.11.0-rc.1
CYCLE_STATUS=planning
CYCLE_TARGET_DATE=2026-09-15
CYCLE_BACKLOG_PROPOSED=0
