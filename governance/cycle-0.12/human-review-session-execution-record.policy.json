{
  "policyVersion": "1.0.0",
  "artifactType": "cycle012-human-review-session-execution-record-policy",
  "cycle": "0.12.0",
  "purpose": "Governar o registro administrativo de uma sessão humana já realizada, sem produzir ou autorizar ações operacionais.",
  "eligibility": {
    "requiredExecutionPackageClassification": "current-and-compatible",
    "requiredSessionMode": "manual-human-review",
    "requiredReferences": [
      "executionPackageId",
      "executionPackageValidationCommit"
    ]
  },
  "requiredSections": [
    "sessionIdentity",
    "participants",
    "responses",
    "reviewChecklistResults",
    "evidenceRecords",
    "decisionRecord",
    "closureRecord",
    "references"
  ],
  "allowedDecisionOutcomes": [
    "approved-administratively",
    "approved-with-follow-up",
    "changes-required",
    "inconclusive",
    "cancelled"
  ],
  "prohibitedOperationalPatterns": [
    "diff --git",
    "BEGIN PATCH",
    "replacementContent",
    "migrationSql",
    "supabase db push",
    "git apply",
    "npm run deploy",
    "eas submit"
  ],
  "controls": {
    "executionRecordGenerationAllowed": true,
    "reviewSessionExecutionAllowed": false,
    "functionalBranchCreationAllowed": false,
    "pullRequestOpeningAllowed": false,
    "patchGenerationAllowed": false,
    "sourceMutationAllowed": false,
    "executionAllowed": false,
    "correctionAuthorized": false,
    "mergeAllowed": false,
    "activationAllowed": false,
    "humanReviewRequired": true
  }
}
