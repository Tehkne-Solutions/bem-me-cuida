{
  "policyVersion": "1.0.0",
  "cycle": "0.12.0",
  "artifactType": "human-review-session-execution-package",
  "purpose": "Preparar uma sessão humana manual de revisão sem executar ações operacionais.",
  "eligibility": {
    "requiredAuthorizationClassification": "current-and-compatible",
    "requiredHumanPresence": true,
    "requiredFacilitator": true
  },
  "allowedSections": [
    "sessionIdentity",
    "participants",
    "agenda",
    "reviewQuestions",
    "reviewChecklist",
    "evidenceFields",
    "decisionFields",
    "closureFields",
    "riskNotes",
    "references"
  ],
  "forbiddenContentPatterns": [
    "diff --git",
    "BEGIN PATCH",
    "replacementContent",
    "migrationSql",
    "supabase db push",
    "git apply",
    "npm run deploy",
    "eas submit"
  ],
  "controls": {
    "executionPackageGenerationAllowed": true,
    "reviewSessionExecutionAllowed": false,
    "functionalBranchCreationAllowed": false,
    "pullRequestOpeningAllowed": false,
    "patchGenerationAllowed": false,
    "sourceMutationAllowed": false,
    "executionAllowed": false,
    "correctionAuthorized": false,
    "mergeAllowed": false,
    "activationAllowed": false,
    "humanReviewRequired": true
  }
}
